{
  "name": "notion-auto-builder",
  "version": "1.0.0",
  "description": "Automatically build and iteratively refine Notion documents using Claude AI",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "notion-auto-builder": "./dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js"
  },
  "keywords": [
    "notion",
    "claude",
    "ai",
    "automation",
    "document-builder"
  ],
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@notionhq/client": "^2.2.0",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "dotenv": "^16.4.0",
    "log-update": "^7.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
